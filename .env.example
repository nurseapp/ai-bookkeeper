# Reference for n8n credential values
# These are NOT used directly — they go into n8n Cloud credentials and variables

# Twilio (for Twilio API credential + Basic Auth credential)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Anthropic (for Header Auth credential)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Sheets (for Google Sheets Service Account credential)
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here
GOOGLE_SERVICE_ACCOUNT_JSON=<paste full JSON key file contents>
